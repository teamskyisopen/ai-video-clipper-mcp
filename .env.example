# ==============================================================================
# AI Video Clipper - Environment Configuration
# ==============================================================================

# Application & Logging
APP_NAME="ai-video-clipper-mcp"
DEBUG=false
LOG_LEVEL="INFO"

# Paths & Binaries
BIN_DIR="./bin"
FFMPEG_PATH="./bin/ffmpeg.exe"
FFPROBE_PATH="./bin/ffprobe.exe"
TEMP_STORAGE_DIR="./storage/temp"
OUTPUT_DIR="./storage/output"

# Output Video Specs (Default 9:16 Portrait Shorts / Reels / TikTok)
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
TARGET_FPS=30
MIN_CLIP_DURATION_SECONDS=15
MAX_CLIP_DURATION_SECONDS=60

# Speech Transcription Engine (faster-whisper / CTranslate2)
# Runs 100% locally on your machine (zero API calls)
# Models: "tiny", "base", "small", "medium", "large-v3"
# Device: "auto" (detects CUDA GPU), "cuda", or "cpu"
WHISPER_MODEL="base"
WHISPER_DEVICE="auto"
WHISPER_COMPUTE_TYPE="default"

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Select provider: "gemini", "openai", or "none" (offline heuristic)
LLM_PROVIDER="gemini"

# Google Gemini Settings
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# OpenAI or OpenAI-Compatible Settings (Ollama, Groq, vLLM, OpenRouter)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_BASE_URL=""

# Offline / Zero-AI Mode
# Set to true to disable all external API calls and use 100% local speech heuristic
OFFLINE_MODE=false

# Subtitle Styling & Placement
# Preset styles: "karaoke_yellow", "neon_cyan", "clean_white", "bold_magenta"
SUBTITLE_FONT_NAME="Arial"
SUBTITLE_FONT_SIZE=22
SUBTITLE_PRIMARY_COLOR="&H00FFFFFF&"
SUBTITLE_HIGHLIGHT_COLOR="&H0000FFFF&"
SUBTITLE_OUTLINE_COLOR="&H00000000&"
SUBTITLE_MARGIN_V=250

# Execution Timeouts (Seconds)
DOWNLOAD_TIMEOUT_SECONDS=600
TRANSCRIPTION_TIMEOUT_SECONDS=600
ANALYSIS_TIMEOUT_SECONDS=180
RENDER_TIMEOUT_SECONDS=600
